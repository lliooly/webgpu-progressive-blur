{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@webgpu-progressive-blur": ["./src/index.ts"],
      "@webgpu-progressive-blur/dom": ["./src/dom/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "vite/client", "node"]
  },
  "include": ["src", "tests", "examples", "vite.config.ts", "vitest.config.ts"]
}
